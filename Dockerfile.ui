# Dockerfile for BenefitsFlow FastAPI Backend + HTML Frontend
FROM python:3.11-slim

WORKDIR /ui

# Copy requirements and install dependencies
# Using minimal requirements for FastAPI + HTML frontend
COPY ui/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt || pip install --no-cache-dir fastapi uvicorn pydantic httpx requests

# Copy application code
COPY ui /ui

# Expose port 8501 for FastAPI (matches serve_frontend.py)
EXPOSE 8501

# Run FastAPI with uvicorn (using serve_frontend which runs on port 8501)
CMD ["uvicorn", "serve_frontend:app", "--host", "0.0.0.0", "--port", "8501"]
