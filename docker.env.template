# docker.env.template
# Copy this file to docker.env and fill in your AWS Secrets Manager ARNs
# docker.env is gitignored for security

# ============================================
# AWS Regions - ALL SET TO US-WEST-2 (OREGON)
# ============================================
S3_REGION=us-west-2
PINECONE_REGION=us-east-1
PINECONE_ENV=aws-us-east-1
BEDROCK_REGION=us-west-2

# ============================================
# AWS Secrets Manager ARNs
# ============================================
# Individual secrets for API keys:
# OPENAI_API_KEY_SECRET_ARN=arn:aws:secretsmanager:us-west-2:ACCOUNT_ID:secret:benefitsflow/openai-api-key-XXXXXX
# PINECONE_API_KEY_SECRET_ARN=arn:aws:secretsmanager:us-west-2:ACCOUNT_ID:secret:benefitsflow/pinecone-api-key-XXXXXX
AWS_BEDROCK_BEARER_TOKEN_SECRET_ARN=arn:aws:secretsmanager:us-west-2:ACCOUNT_ID:secret:benefitsflow/bedrock-token-XXXXXX

# ============================================
# Pinecone Configuration
# ============================================
PINECONE_INDEX_NAME=benefitsflow
PINECONE_DIM=1536

# ============================================
# Model Configuration
# ============================================
EMBED_MODEL=text-embedding-3-small
LLM_MODEL=openai.gpt-oss-120b-1:0

# ============================================
# UI Service Configuration
# ============================================
# For TWO SEPARATE EC2 INSTANCES:
#   Set RAG_API_URL to RAG instance's PRIVATE IP address
#   Example: RAG_API_URL=http://10.0.1.123:8000
#   (Get private IP from EC2 console or: curl http://169.254.169.254/latest/meta-data/local-ipv4 on RAG instance)
#
# For SINGLE INSTANCE with docker-compose:
#   RAG_API_URL is set in docker-compose.yml environment section
#   RAG_API_URL=http://app:8000
#
# RAG_API_URL=http://RAG_PRIVATE_IP:8000
