
# AWS credentials (for local dev; prefer IAM in production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Regions
S3_REGION=us-west-2
PINECONE_REGION=us-east-1
PINECONE_ENV=aws-us-east-1
BEDROCK_REGION=us-east-1

# Either set direct keys OR reference Secrets Manager ARNs below
OPENAI_API_KEY=
OPENAI_API_KEY_SECRET_ARN=
PINECONE_API_KEY=
PINECONE_API_KEY_SECRET_ARN=
AWS_BEDROCK_BEARER_TOKEN_SECRET_ARN=

# Pinecone index
PINECONE_INDEX_NAME=knowledge
PINECONE_DIM=1536

# Models
EMBED_MODEL=text-embedding-3-small
LLM_MODEL=openai.gpt-oss-120b-1:0
